{
  "name": "chintalk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:content": "tsx scripts/build-content.ts",
    "build:icons": "node scripts/build-icons.cjs",
    "build:tts": "tsx scripts/build-tts.ts",
    "verify:tts": "tsx scripts/verify-tts-coverage.ts",
    "test:meaning": "tsx --test scripts/meaning-units.test.ts",
    "test:study": "tsx --test scripts/study-content.test.ts",
    "test:recall": "tsx --test scripts/recall.test.ts",
    "test:pwa": "npm run build && node scripts/pwa-updates.browser.cjs",
    "test:follow": "npm run build && node scripts/playback-follow.browser.cjs",
    "test:basic": "npm run build && node scripts/basic-mode.browser.cjs",
    "test:learning-listening": "npm run build && node scripts/learning-listening.browser.cjs",
    "build": "npm run build:content && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@node-rs/jieba": "^2.0.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "msedge-tts": "^2.1.1",
    "playwright-core": "1.65.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^0.20.5"
  }
}
